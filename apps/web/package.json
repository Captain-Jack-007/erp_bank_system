{
  "name": "@xb/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:vite": "vite build && node -e \"const fs=require('fs');fs.rmSync('../../dist',{recursive:true,force:true});fs.cpSync('dist','../../dist',{recursive:true})\""
  },
  "dependencies": {
    "@xb/shared": "*",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "@types/react-dom": "~19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.0"
  }
}
